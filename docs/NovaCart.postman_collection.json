    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Razorpay order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "orders"
              ]
            },
            "description": "Requires RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (test mode). Returns 503 when not configured."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 503 when unconfigured', () => pm.expect([201, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('razorpayOrderId', body.razorpayOrderId);",
                  "  pm.test('Key secret never returned', () => {",
                  "    pm.expect(JSON.stringify(body)).to.not.include('razorpayKeySecret');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify payment signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpaySignature\": \"{{razorpaySignature}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "verify"
              ]
            },
            "description": "Values come from the Razorpay Checkout success handler. An invalid HMAC returns 400 and never changes payment status."
          }
        },
        {
          "name": "Payment status for order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "order",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Razorpay webhook (signed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Razorpay-Signature",
                "value": "{{razorpayWebhookSignature}}"
              },
              {
                "key": "X-Razorpay-Event-Id",
                "value": "evt_postman_demo_1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_demo\",\n        \"order_id\": \"order_demo\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "webhook"
              ]
            },
            "description": "Public endpoint, but only a correctly signed body is accepted. Signature = HMAC_SHA256(rawBody, RAZORPAY_WEBHOOK_SECRET)."
          }
        }
      ]
    },
    {
      "name": "Negative / Security Cases",
