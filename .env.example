# Copy this file to .env at the repository root and fill in real values.
# .env is gitignored. Never commit real credentials or secrets.
#
# When running locally, every backend service loads ../.env (or ./.env from its module dir).
# Real environment variables always take precedence over this file.
#
# Docker Compose passes every key in this file into the backend containers via env_file.
# Its explicit environment entries also read this file through ${VAR:-default}
# interpolation, with safe local defaults when omitted.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
DB_USERNAME=ecommerce
DB_PASSWORD=change-me-app-password
# Only used by the Docker MySQL container (root account).
DB_ROOT_PASSWORD=change-me-root-password

# Optional global DB URL override. Leave empty for local development so each
# service uses its own schema: ecommerce_db, product_db, order_db, payment_db,
# notification_db. In Docker Compose this is the fallback for the per-service URLs below.
# DB_URL=

# Docker Compose only: override one service's DB URL (takes precedence over DB_URL).
# AUTH_DB_URL=jdbc:mysql://mysql:3306/ecommerce_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# PRODUCT_DB_URL=jdbc:mysql://mysql:3306/product_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# ORDER_DB_URL=jdbc:mysql://mysql:3306/order_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# PAYMENT_DB_URL=jdbc:mysql://mysql:3306/payment_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# NOTIFICATION_DB_URL=jdbc:mysql://mysql:3306/notification_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ---------------------------------------------------------------------------
# JWT (shared by auth, product, order, payment and the gateway)
# ---------------------------------------------------------------------------
# HS256 key, MUST be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api

# ---------------------------------------------------------------------------
# Service-to-service security
# ---------------------------------------------------------------------------
# Shared key for /internal/** endpoints (product stock reserve/release,
# order summary lookup). Never expose this to the browser.
INTERNAL_API_KEY=change-me-internal-api-key-at-least-32-chars

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the services directly)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Service URLs (local defaults shown; Docker Compose overrides these)
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8080
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084

# ---------------------------------------------------------------------------
# Kafka (order/payment/notification services)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Set false to start services without connecting consumers (useful for debugging).
KAFKA_LISTENERS_ENABLED=true
# Transactional outbox publisher (order/payment services).
OUTBOX_ENABLED=true

# ---------------------------------------------------------------------------
# Redis (product service cache)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Razorpay TEST MODE ONLY
# ---------------------------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key.
# Use rzp_test_... credentials. Never put these in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://<public-url>/api/payments/webhook
# with events payment.captured, payment.failed, order.paid.
# Leave blank to disable webhook handling (returns 503 until configured).
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---------------------------------------------------------------------------
# SMTP (notification service)
# ---------------------------------------------------------------------------
# Docker Compose points these at MailHog (UI at http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_ENABLED=true
MAIL_FROM=no-reply@novacart.local

# ---------------------------------------------------------------------------
# Bootstrap administrator (auth service)
# ---------------------------------------------------------------------------
# When both are set, the auth service creates (or promotes) this ADMIN account
# at startup. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Set to true only for local SQL debugging. Never in production.
JPA_SHOW_SQL=false

# Frontend (only used at build/dev time)
# Empty means the browser calls the same origin under /api (nginx/Vite proxy).
VITE_API_BASE_URL=
# Used by the Vite dev server proxy only; read from Vite env files by loadEnv.
VITE_GATEWAY_URL=http://localhost:8081
